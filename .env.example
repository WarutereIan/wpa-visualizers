# Google Gemini API — used by `npm run generate:logo` (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=

# Pricing page — optional Open Exchange Rates app_id for locale currency conversion (Frankfurter used as fallback)
# VITE_OPEN_EXCHANGE_RATES_APP_ID=

# Baseline mapping iframe URL (optional). Defaults to a public OpenStreetMap embed.
VITE_BASELINE_MAP_URL=https://gartsafrica.com/nyahururu_WASH_program/

# Data import — optional defaults for Kobo (prefilled on Data import page; never commit secrets).
# VITE_KOBO_DEFAULT_URL=https://kf.kobotoolbox.org/api/v2/assets/ASSET_ID/data/?format=json
# VITE_KOBO_TOKEN=

# Data import — optional defaults for Microsoft Dynamics 365 (Dataverse).
# VITE_DYNAMICS365_DEFAULT_URL=https://your-org.crm.dynamics.com/api/data/v9.2/accounts?$select=name,accountid
# VITE_DYNAMICS365_BEARER_TOKEN=
# VITE_DYNAMICS365_TENANT_ID=
# VITE_DYNAMICS365_CLIENT_ID=
# VITE_DYNAMICS365_CLIENT_SECRET=
# VITE_DYNAMICS365_SCOPE=https://your-org.crm.dynamics.com/.default

# Data import — optional defaults for SurveyCTO.
# VITE_SURVEYCTO_DEFAULT_URL=https://your-server.surveycto.com/api/v2/datasets/cases/records
# VITE_SURVEYCTO_USERNAME=
# VITE_SURVEYCTO_PASSWORD=
